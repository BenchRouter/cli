#!/usr/bin/env node
import { appendFileSync, readFileSync } from 'node:fs';

// Recorded auth-describe and auth-token wire shapes, with synthetic credentials.
const argv = process.argv.slice(2);
if (process.env.BR_FIXTURE_AUTH_LOG) appendFileSync(process.env.BR_FIXTURE_AUTH_LOG, `${JSON.stringify(argv)}\n`);
if (argv[0] !== 'auth' || !['describe', 'token'].includes(argv[1]) || !argv.includes('--host') || !argv.includes('--output')) process.exit(2);
const mode = process.env.BR_FIXTURE_AUTH;
if (process.env.BR_FIXTURE_AUTH === 'child-error') {
  process.stderr.write('fake-login-token-must-not-leak');
  process.exit(1);
}
if (argv[1] === 'describe') {
  const answer = JSON.parse(readFileSync(new URL('../auth-describe.json', import.meta.url), 'utf8'));
  const authType = mode === 'pat' ? 'pat' : mode?.startsWith('m2m') ? 'oauth-m2m' : mode === 'unsupported' ? 'azure-cli' : 'databricks-cli';
  answer.details.auth_type = answer.details.configuration.auth_type.value = authType;
  if (authType === 'oauth-m2m') {
    answer.username = '00000000-0000-4000-8000-000000000099';
    answer.details.configuration.client_id = { value: answer.username };
    answer.details.configuration.client_secret = { value: argv.includes('--sensitive') ? 'fixture-m2m-client-secret-must-not-leak' : '********' };
  }
  process.stdout.write(JSON.stringify(answer));
} else if (mode === 'pat') {
  // A real PAT token response has no auth_type. Connect must refuse before this call.
  process.stdout.write(JSON.stringify({ access_token: 'fake-login-token-must-not-leak', token_type: 'Bearer' }));
} else if (mode?.startsWith('m2m')) {
  process.stderr.write('auth token only supports U2M authentication');
  process.exit(1);
} else {
  const stale = process.env.BR_FIXTURE_AUTH === 'refresh' && !argv.includes('--force-refresh');
  const encode = (v) => Buffer.from(JSON.stringify(v)).toString('base64url');
  const claims = { iss: 'https://fixture.cloud.databricks.com/oidc', sub: 'admin@example.com', aud: ['7474660687257254'], client_id: 'databricks-cli', scope: 'all-apis offline_access', iat: Math.floor(Date.now()/1000), exp: Math.floor(Date.now()/1000)+(stale ? 60 : 3600) };
  process.stdout.write(JSON.stringify({ access_token: `${encode({ alg: 'RS256', typ: 'at+jwt', kid: 'recorded' })}.${encode(claims)}.fake-login-token-must-not-leak`, token_type: 'Bearer', expiry: new Date(claims.exp*1000).toISOString() }));
}
